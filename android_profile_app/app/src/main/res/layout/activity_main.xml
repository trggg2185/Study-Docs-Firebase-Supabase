<?xml version="1.0" encoding="utf-8"?>
<!--
    FILE LAYOUT: activity_main.xml
    Sử dụng ScrollView bọc ngoài cùng để hỗ trợ cuộn màn hình,
    ngăn ngừa lỗi tràn giao diện khi hiển thị trên các màn hình kích thước nhỏ
    hoặc khi người dùng xoay ngang màn hình (Landscape).
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:fillViewport="true">

    <!--
        SỬ DỤNG ConstraintLayout:
        - Tối ưu hóa hiệu năng render (bố cục phẳng - Flat Hierarchy).
        - Linh hoạt căn chỉnh vị trí tương đối giữa các phần tử bằng các Constraint,
          giúp giao diện hiển thị đồng nhất và chuẩn xác trên mọi kích thước màn hình Android.
    -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- THẺ CARDVIEW: Tạo khung chứa trắng nổi bật, bo góc tròn và đổ bóng -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardProfile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/card_background"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_max="540dp">

            <!-- LinearLayout dọc sắp xếp nội dung bên trong Card từ trên xuống dưới -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="24dp">

                <!--
                    1. IMAGEVIEW: Hiển thị ảnh đại diện cá nhân
                    - app:shapeAppearanceOverlay: Cắt ảnh thành hình tròn hoàn hảo
                    - android:scaleType="centerCrop": Giữ đúng tỉ lệ ảnh
                -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgAvatar"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/avatar"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/CircleImageView"
                    app:strokeColor="@color/teal_primary"
                    app:strokeWidth="3dp"
                    android:contentDescription="Ảnh đại diện" />

                <!--
                    2. TEXTVIEW: Hiển thị Họ và Tên
                -->
                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/profile_name"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <!--
                    3. TEXTVIEW: Hiển thị Chức danh / Nghề nghiệp
                -->
                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/profile_title"
                    android:textColor="@color/teal_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="#E0F2F1"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp" />

                <!-- Đường kẻ ngang phân cách (Divider) -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="20dp"
                    android:background="#E2E8F0" />

                <!-- TIÊU ĐỀ KHỐI TIỂU SỬ -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/bio_title"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!--
                    4. TEXTVIEW: Hiển thị nội dung tiểu sử bản thân
                    - lineHeight: Khoảng cách giữa các dòng chữ giúp đọc dễ dàng
                -->
                <TextView
                    android:id="@+id/tvBio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/bio_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp" />

                <!-- Đường kẻ ngang phân cách (Divider) -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="20dp"
                    android:background="#E2E8F0" />

                <!-- TIÊU ĐỀ KHỐI MẠNG XÃ HỘI -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/social_title"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!--
                    5. CÁC NÚT BUTTON CHO MẠNG XÃ HỘI:
                    Bố trí các Button liên kết, mỗi nút có màu sắc đặc trưng
                    và được gán sự kiện click mở Intent trong Activity.
                -->
                <!-- Nút GitHub -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGithub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_github"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/github_color"
                    app:cornerRadius="10dp"
                    android:textAllCaps="false"
                    android:paddingVertical="12dp"
                    android:layout_marginBottom="8dp" />

                <!-- Nút Facebook -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFacebook"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_facebook"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/facebook_color"
                    app:cornerRadius="10dp"
                    android:textAllCaps="false"
                    android:paddingVertical="12dp"
                    android:layout_marginBottom="8dp" />

                <!-- Nút LinkedIn -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLinkedin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_linkedin"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/linkedin_color"
                    app:cornerRadius="10dp"
                    android:textAllCaps="false"
                    android:paddingVertical="12dp"
                    android:layout_marginBottom="8dp" />

                <!-- Nút Email -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_email"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/email_color"
                    app:cornerRadius="10dp"
                    android:textAllCaps="false"
                    android:paddingVertical="12dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>

